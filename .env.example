# ---------------------------------------------------------------------------
# One file per company. This is the whole per-site configuration.
# ---------------------------------------------------------------------------

COMPANY_NAME="Acme Engineering"

# Where the project tree lives on the Docker host.
STORAGE_ROOT_HOST=/srv/projects
LIBRARY_HOST=/srv/library_master

# Paths as seen INSIDE the container. Leave these alone unless you change
# the volume mounts in docker-compose.yml.
STORAGE_ROOT=/srv/projects
DATABASE_URL=sqlite3:/srv/data/production.sqlite3

# How workstations reach a project to OPEN drawings in place.
# %{slug} is substituted per project. Must match the SMB share you export.
#   \\fileserver\proj_acme-123$
UNC_TEMPLATE='\\fileserver\proj_%{slug}$'
SHARE_TEMPLATE='proj_%{slug}$'

# Time zone for dates shown in the app (activity log). Any IANA name.
TIME_ZONE=Europe/Berlin

# Intranet only. Bind the proxy to the LAN NIC, never 0.0.0.0.
LAN_BIND_IP=10.0.0.5
APP_HOST=projects.acme.local

# First administrator, created by `rake admin:seed`.
SEED_ADMIN_EMAIL=admin@acme.local
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_PASSWORD=change-me-immediately

RAILS_ENV=production
SECRET_KEY_BASE=generate-with-rails-secret
