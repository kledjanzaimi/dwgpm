# HTTPS on the intranet host name. `tls internal` issues a certificate from
# Caddy's own local CA, since an intranet name cannot get a public one.
# Workstations trust it by importing Caddy's root certificate, found in the
# caddy_data volume at /data/caddy/pki/authorities/local/root.crt
# (or replace this block with the company's own certificate).
{$APP_HOST} {
	tls internal

	# Uploads of large drawing sets.
	request_body {
		max_size 2GB
	}

	reverse_proxy app:3000
}
