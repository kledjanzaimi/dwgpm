<!DOCTYPE html>
<html>
  <head>
    <title><%= [content_for(:title), ENV.fetch("COMPANY_NAME", "DWG Project Manager")].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topbar">
      <%= link_to ENV.fetch("COMPANY_NAME", "DWG Project Manager"), root_path, class: "brand" %>
      <% if current_user %>
        <nav>
          <%= link_to "Projects", projects_path %>
          <%= link_to "Users", users_path if current_user.global_admin? %>
          <span class="who"><%= current_user.name %></span>
          <%= button_to "Sign out", logout_path, method: :delete, class: "link" %>
        </nav>
      <% end %>
    </header>

    <main>
      <% flash.each do |type, message| %>
        <p class="flash flash-<%= type %>"><%= message %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
