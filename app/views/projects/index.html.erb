<% content_for :title, "Projects" %>

<div class="heading">
  <h1>Projects</h1>
  <%= link_to "New project", new_project_path, class: "button" if current_user.global_admin? %>
</div>

<% if @projects.any? %>
  <table class="listing">
    <thead>
      <tr><th>Name</th><th>Slug</th><th>Your role</th><th></th></tr>
    </thead>
    <tbody>
      <% @projects.each do |project| %>
        <tr>
          <td><%= link_to project.name, project_files_path(project) %></td>
          <td><code><%= project.slug %></code></td>
          <td><%= (project.role_for(current_user) || (current_user.global_admin? ? "admin" : "")).humanize %></td>
          <td class="actions">
            <%= link_to "Members", project_memberships_path(project) %>
            <% if current_user.global_admin? || project.role_for(current_user) == "project_manager" %>
              <%= link_to "Activity", project_activity_path(project) %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty">
    <%= current_user.global_admin? ? "No projects yet. Create the first one." : "You are not a member of any project yet." %>
  </p>
<% end %>
